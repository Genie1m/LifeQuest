# Real provider requests remain disabled unless BOTH development mode and this flag are set.
# Never put an API key here. Enter your own key in /settings/models at runtime.
LIFEQUEST_ENABLE_REAL_LLM=false
# Optional additional trusted HTTPS API bases, comma separated, no key or query string.
# Preset relay and Qwen official bases are included in the server allowlist.
LIFEQUEST_TRUSTED_LLM_BASE_URLS=
